# =============================================================================
# Industrial Defect Image Retrieval - Environment Configuration
# Copy this file to .env and modify values as needed
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=defect_inspection_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5433

# Spring Boot Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Python Inference Service URL (Phase TV3 integration)
PYTHON_IMAGE_SERVICE_URL=http://localhost:8000
