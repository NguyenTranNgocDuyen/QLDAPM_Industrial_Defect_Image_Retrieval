# =============================================================================
# Industrial Defect Image Retrieval - Environment Configuration
# Copy this file to .env and modify values as needed
# =============================================================================

# PostgreSQL Configuration
POSTGRES_DB=defect_inspection_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5433

# Spring Boot Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Python Inference Service URL (Phase TV3 integration)
PYTHON_IMAGE_SERVICE_URL=http://localhost:8000

# Roboflow Phone Segmentation Model Configuration
# Required for auto-downloading phone segmentation model for perspective correction
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_PHONE_MODEL_ID=phone-segmentation-uiymg/1
