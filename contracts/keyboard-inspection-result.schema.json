{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "type":"object", "additionalProperties":false,
  "required":["inspectionId","success","status","hasDefect","sourceImage","displayImage","keyboard","defects","summary","processing","assets"],
  "properties":{
    "inspectionId":{"type":"string","format":"uuid"},"success":{"type":"boolean"},"status":{"enum":["completed","insufficient_evidence","processing_error"]},"hasDefect":{"type":"boolean"},
    "sourceImage":{"$ref":"#/$defs/image"},"displayImage":{"$ref":"#/$defs/image"},
