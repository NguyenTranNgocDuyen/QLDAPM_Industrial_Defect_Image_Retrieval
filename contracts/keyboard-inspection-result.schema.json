    "defects":{"type":"array","items":{"type":"object","required":["id","type","severity","confidence","keyLabel","row","column","bbox","reason"],"properties":{"id":{"type":"string"},"type":{"enum":["missing_key","shifted_key","tilted_key","damaged_keycap","wrong_keycap","uncertain"]},"severity":{"enum":["minor","moderate","severe","unknown"]},"confidence":{"type":"number"},"keyLabel":{"type":["string","null"]},"row":{"type":["integer","null"]},"column":{"type":["integer","null"]},"bbox":{"$ref":"#/$defs/bbox"},"reason":{"type":"string"}}}},
    "summary":{"type":"object","required":["defectCount","needsReview","reasons"],"properties":{"defectCount":{"type":"integer"},"needsReview":{"type":"boolean"},"reasons":{"type":"array","items":{"type":"string"}}}},
    "processing":{"type":"object","required":["preprocessingMs","inferenceMs","postprocessingMs","totalMs"],"properties":{"preprocessingMs":{"type":"number"},"inferenceMs":{"type":"number"},"postprocessingMs":{"type":"number"},"totalMs":{"type":"number"}}},
