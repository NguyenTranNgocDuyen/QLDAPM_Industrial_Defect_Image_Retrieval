  }, "$defs":{"image":{"type":"object","required":["url","width","height","coordinateSpace"],"properties":{"url":{"type":"string"},"width":{"type":"integer"},"height":{"type":"integer"},"coordinateSpace":{"enum":["source","processed"]}}},"bbox":{"type":"object","required":["x1","y1","x2","y2","coordinateSpace"],"properties":{"x1":{"type":"number"},"y1":{"type":"number"},"x2":{"type":"number"},"y2":{"type":"number"},"coordinateSpace":{"const":"source"}}}}}
