# Roboflow Phone Segmentation Model Configuration
# Required for auto-downloading phone segmentation model for perspective correction
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_PHONE_MODEL_ID=phone-segmentation-uiymg/1
